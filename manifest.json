{
  "id": "/",
  "name": "divIDE",
  "short_name": "divIDE",
  "description": "Phone-native single-file code editor with built-in diagnostics, linting, and project tools.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "categories": [
    "developer",
    "productivity",
    "utilities"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/x-csrc": [
          ".c",
          ".h"
        ],
        "text/x-c++src": [
          ".cpp",
          ".cc",
          ".cxx",
          ".hpp",
          ".hh",
          ".hxx"
        ],
        "text/css": [
          ".css"
        ],
        "text/x-go": [
          ".go"
        ],
        "text/html": [
          ".html",
          ".htm"
        ],
        "text/x-java-source": [
          ".java"
        ],
        "text/javascript": [
          ".js",
          ".mjs",
          ".cjs"
        ],
        "application/json": [
          ".json",
          ".map"
        ],
        "text/jsx": [
          ".jsx"
        ],
        "text/x-less": [
          ".less"
        ],
        "text/markdown": [
          ".md",
          ".markdown",
          ".mkd"
        ],
        "application/x-httpd-php": [
          ".php",
          ".phtml"
        ],
        "text/x-python": [
          ".py",
          ".pyw",
          ".pyx"
        ],
        "text/x-rustsrc": [
          ".rs"
        ],
        "text/x-sass": [
          ".sass"
        ],
        "text/x-scss": [
          ".scss"
        ],
        "application/sql": [
          ".sql"
        ],
        "text/tsx": [
          ".tsx"
        ],
        "application/typescript": [
          ".ts",
          ".mts",
          ".cts"
        ],
        "application/wasm": [
          ".wat",
          ".wast"
        ],
        "application/xml": [
          ".xml",
          ".xsl",
          ".xsd"
        ],
        "image/svg+xml": [
          ".svg"
        ],
        "application/yaml": [
          ".yaml",
          ".yml"
        ],
        "text/x-csharp": [
          ".cs"
        ],
        "text/x-clojure": [
          ".clj",
          ".cljc",
          ".cljx",
          ".cljs",
          ".edn"
        ],
        "text/x-cmake": [
          ".cmake"
        ],
        "text/x-coffeescript": [
          ".coffee"
        ],
        "text/x-dart": [
          ".dart"
        ],
        "text/x-diff": [
          ".diff",
          ".patch"
        ],
        "text/x-erlang": [
          ".erl"
        ],
        "text/x-fortran": [
          ".f",
          ".for",
          ".f77",
          ".f90",
          ".f95"
        ],
        "text/x-fsharp": [
          ".fs"
        ],
        "text/x-gherkin": [
          ".feature"
        ],
        "text/x-groovy": [
          ".groovy",
          ".gradle"
        ],
        "text/x-haskell": [
          ".hs"
        ],
        "text/x-ini": [
          ".ini",
          ".properties"
        ],
        "text/x-julia": [
          ".jl"
        ],
        "text/x-kotlin": [
          ".kt",
          ".kts"
        ],
        "text/x-lisp": [
          ".lisp",
          ".cl",
          ".el"
        ],
        "text/x-lua": [
          ".lua"
        ],
        "text/x-objectivec": [
          ".m",
          ".mm"
        ],
        "text/x-ocaml": [
          ".ml",
          ".mli"
        ],
        "text/x-pascal": [
