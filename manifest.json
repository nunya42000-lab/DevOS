{
  "id": "/",
  "name": "divIDE",
  "short_name": "divIDE",
  "description": "Phone-native single-file code editor with built-in diagnostics, linting, and project tools.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "categories": ["developer", "productivity", "utilities"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "./icon192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon192maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon512maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/html": [".html", ".htm"],
        "text/javascript": [".js", ".mjs", ".jsx"],
        "text/css": [".css"],
        "application/json": [".json"],
        "text/markdown": [".md"],
        "text/plain": [".txt"],
        "application/typescript": [".ts", ".tsx"],
        "text/x-python": [".py"],
        "application/xml": [".xml"],
        "image/svg+xml": [".svg"]
      },
      "icons": [
        {
          "src": "./icon512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "New File",
      "short_name": "New",
      "description": "Start a new file in divIDE",
      "url": "./?action=new",
      "icons": [
        {
          "src": "./icon192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Force Update",
      "short_name": "Update",
      "description": "Clear the cached app shell and redownload the latest version",
      "url": "./?action=force-update",
      "icons": [
        {
          "src": "./icon192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Wipe Project",
      "short_name": "Wipe",
      "description": "Permanently delete every file in the current project (asks for confirmation first)",
      "url": "./?action=wipe-vfs",
      "icons": [
        {
          "src": "./icon192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
