          ".psd1",
          ".psm1"
        ],
        "text/x-protobuf": [
          ".proto"
        ],
        "text/x-puppet": [
          ".pp"
        ],
        "text/x-r": [
          ".r"
        ],
        "text/x-ruby": [
          ".rb"
        ],
        "text/x-scala": [
          ".scala"
        ],
        "application/x-sh": [
          ".sh",
          ".bash",
          ".ksh"
        ],
        "text/x-smalltalk": [
          ".st"
        ],
        "application/toml": [
          ".toml"
        ],
        "text/x-swift": [
          ".swift"
        ],
        "text/x-tcl": [
          ".tcl"
        ],
        "text/x-tex": [
          ".tex",
          ".ltx"
        ],
        "text/x-vb": [
          ".vb"
        ],
        "text/vbscript": [
          ".vbs"
